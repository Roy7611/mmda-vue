{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "lib": ["ES2022", "DOM"],
    "types": ["vite/client"],
    "paths": {
      "@/*": ["../mes/src/*"],
      "@mmda/core": ["../core/src/index.ts"],
      "@mmda/vui": ["../vui/src/index.ts"],
      "@mmda/vui-syncfusion": ["../vui-syncfusion/src/index.ts"],
      "@mmda/base/*": ["../base/*"],
      "@mmda/mes/*": ["../mes/*"]
    }
  },
  "include": ["src", "vite.config.ts", "vitest.config.ts"]
}
