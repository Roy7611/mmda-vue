{
  "name": "@mmda/vui",
  "description": "Metadata Model Driven Architecture Vue UI runtime",
  "author": "roshion luo",
  "license": "MIT",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "main": "./dist/mmda-vui.es.js",
  "module": "./dist/mmda-vui.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/mmda-vui.es.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode lib && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit && tsc -p tsconfig.vitest.json --noEmit && tsc -p tsconfig.node.json --noEmit"
  },
  "dependencies": {
    "@mmda/core": "workspace:^"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "vue-i18n": "^9.14.0 || ^10 || ^11",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitejs/plugin-vue-jsx": "^5.1.1",
    "jsdom": "^30.0.1",
    "typescript": "~5.9.3",
    "vite": "8.2.2",
    "vitest": "^4.1.11",
    "vue": "^3.5.25",
    "vue-i18n": "^11.1.11",
    "vue-router": "^4.5.1",
    "vue-tsc": "^2.2.12"
  }
}
