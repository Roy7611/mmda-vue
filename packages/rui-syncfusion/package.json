{
  "name": "@mmda/rui-syncfusion",
  "description": "Syncfusion EJ2 React skin for the MMDA React UI runtime",
  "author": "www.mmda.cloud",
  "license": "MIT",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/mmda-rui-syncfusion.es.js",
  "module": "./dist/mmda-rui-syncfusion.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/mmda-rui-syncfusion.es.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "vite build --mode lib && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit && tsc -p tsconfig.vitest.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "typecheck:dist": "tsc -p tsconfig.lib.json --noEmit"
  },
  "dependencies": {
    "@mmda/core": "workspace:^",
    "@mmda/rui": "workspace:^",
    "@syncfusion/ej2-base": "^34.2.2",
    "@syncfusion/ej2-react-barcode-generator": "^34.2.2",
    "@syncfusion/ej2-react-buttons": "^34.2.2",
    "@syncfusion/ej2-react-calendars": "^34.2.2",
    "@syncfusion/ej2-react-dropdowns": "^34.2.2",
    "@syncfusion/ej2-react-grids": "^34.2.2",
    "@syncfusion/ej2-react-inplace-editor": "^34.2.2",
    "@syncfusion/ej2-react-inputs": "^34.2.2",
    "@syncfusion/ej2-react-layouts": "^34.2.2",
    "@syncfusion/ej2-react-lists": "^34.2.2",
    "@syncfusion/ej2-react-navigations": "^34.2.2",
    "@syncfusion/ej2-react-notifications": "^34.2.2",
    "@syncfusion/ej2-react-popups": "^34.2.2",
    "@syncfusion/ej2-react-progressbar": "^34.2.2",
    "@syncfusion/ej2-react-querybuilder": "^34.2.2",
    "@syncfusion/ej2-react-splitbuttons": "^34.2.2",
    "@syncfusion/ej2-react-treegrid": "^34.2.2"
  },
  "peerDependencies": {
    "react": "^19.0.0 || ^18.3.0",
    "react-dom": "^19.0.0 || ^18.3.0"
  },
  "devDependencies": {
    "@syncfusion/ej2-react-charts": "^34.2.2",
    "@syncfusion/ej2-react-gantt": "^34.2.2",
    "@types/node": "^20.19.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "~5.9.3",
    "vite": "8.2.2",
    "vitest": "^4.1.11"
  }
}
