{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "strict": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "lib": [
      "ESNext",
      "DOM"
    ],
    "skipLibCheck": true,
    "preserveConstEnums": true,
    "noEmit": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@mmda/core": [
        "../core/src/index.ts"
      ],
      "@mmda/i18n": [
        "../i18n/src/index.ts"
      ],
      "@mmda/i18n/src/*": [
        "../i18n/src/*"
      ]
    }
  }
}
