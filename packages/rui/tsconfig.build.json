{
  "extends": "./tsconfig.lib.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@mmda/core": [
        "../core/dist/index.d.ts"
      ],
      "@mmda/i18n": [
        "../i18n/dist/index.d.ts"
      ],
      "@mmda/i18n/src/*": [
        "../i18n/dist/*.d.ts"
      ]
    }
  }
}
