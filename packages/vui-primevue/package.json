    "jsdom": "^30.0.1",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.5",
    "qrcode": "^1.5.4",
    "typescript": "~5.9.3",
    "vite": "8.2.2",
    "vitest": "^4.1.11",
    "vue": "^3.5.25",
    "vue-i18n": "^11.1.11",
    "vue-router": "^4.5.1"
  }
