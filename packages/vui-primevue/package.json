      "optional": true
    },
    "jsbarcode": {
      "optional": true
    },
    "qrcode": {
      "optional": true
    }
  },
  "devDependencies": {
    "@bpmn-io/properties-panel": "^3.51.2",
    "@primevue/themes": "4.5.4",
    "@types/jsbarcode": "^3.11.4",
    "@types/node": "^20.19.0",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitejs/plugin-vue-jsx": "^5.1.1",
    "@vue-office/docx": "^1.6.3",
    "@vue-office/excel": "^1.7.14",
    "bpmn-js": "^18.25.1",
    "bpmn-js-properties-panel": "^5.65.0",
