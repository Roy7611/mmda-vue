# Same-origin API (recommended with `pnpm dev:apps` → http://127.0.0.1:5100).
# Absolute http://127.0.0.1:8001/api makes getRefSystemAddress point at the API host.
VITE_BASE_API=/api

# OAuth client credentials for password grant (do not commit real secrets)
VITE_OAUTH_CLIENT_ID=mmda-mes
VITE_OAUTH_CLIENT_SECRET=123

# Syncfusion EJ2 license (watermark appears if empty)
VITE_SYNCFUSION_LICENSE=
