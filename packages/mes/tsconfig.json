{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "lib": ["ES2022", "DOM"],
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "@mmda/base/*": ["../base/*"]
    }
  },
  "include": ["src"]
}
