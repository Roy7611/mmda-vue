{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "lib": ["ES2022", "DOM"],
    "types": ["vite/client"],
    "paths": {
      "@mmda/core": ["../core/src/index.ts"],
      "@mmda/vui": ["../vui/src/index.ts"],
      "@mmda/vui-agnaive": ["../vui-agnaive/src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
